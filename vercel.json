{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/lobekalender/kobenhavn(?:/(.*))?$",
      "headers": {
        "Location": "/lobekalender/hovedstaden/$1"
      },
      "status": 308
    },
    {
      "src": "^/bėgimo_puslapiai(?:/(.*))?$",
      "headers": {
        "Location": "/begimo_puslapiai/$1"
      },
      "status": 308
    },
    {
      "src": "^/b%C4%97gimo_puslapiai(?:/(.*))?$",
      "headers": {
        "Location": "/begimo_puslapiai/$1"
      },
      "status": 308
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "BR",
              "HK",
              "SG",
              "CN",
              "RU",
              "VN"
            ]
          }
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ],
  "redirects": [
    {
      "source": "/lobekalender/kobenhavn/:path*",
      "destination": "/lobekalender/hovedstaden/:path*",
      "permanent": true
    },
    {
      "source": "/bėgimo_puslapiai/:path*",
      "destination": "/begimo_puslapiai/:path*",
      "permanent": true
    },
    {
      "source": "/b%C4%97gimo_puslapiai/:path*",
      "destination": "/begimo_puslapiai/:path*",
      "permanent": true
    }
  ]
}

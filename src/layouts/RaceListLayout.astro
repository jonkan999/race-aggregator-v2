---
import '../styles/legacy/legacy-race-list.css';
import '../styles/islands.css';
import '../styles/v2-race-list-bridge.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { IndexYaml } from '../lib/content';

type LayoutLocale = 'native' | 'en';

interface Props {
  title: string;
  description?: string;
  lang: string;
  country: string;
  locale: LayoutLocale;
  content: IndexYaml;
  alternateRaceListHref?: string;
}

const { title, description = '', lang, country, locale, content, alternateRaceListHref } =
  Astro.props;
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/common_images/logo.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    <slot name="head" />
  </head>
  <body class="race-list-page v2-race-list loaded">
    <div id="page-wrapper">
      <main>
        <SiteHeader
          country={country}
          locale={locale}
          content={content}
          alternateRaceListHref={alternateRaceListHref}
          raceListPage={true}
        />
        <slot />
      </main>
      <SiteFooter country={country} locale={locale} content={content} />
    </div>
  </body>
</html>

---
import '../styles/legacy/legacy-race-list.css';
import '../styles/islands.css';
import '../styles/v2-race-list-bridge.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import NewsletterPopupConfig from '../components/NewsletterPopupConfig.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { IndexYaml } from '../lib/content';
import { getMarketRouteTargets } from '../lib/marketRouteTargets';

type LayoutLocale = 'native' | 'en';

interface Props {
  title: string;
  description?: string;
  lang: string;
  country: string;
  locale: LayoutLocale;
  content: IndexYaml;
  alternateRaceListHref?: string;
  noindex?: boolean;
  disableCanonical?: boolean;
}

const { title, description = '', lang, country, locale, content, alternateRaceListHref } =
  Astro.props;
const noindex = Boolean(Astro.props.noindex);
const disableCanonical = Boolean(Astro.props.disableCanonical);
const marketRouteTargetsJson = JSON.stringify(getMarketRouteTargets());
const baseUrl = String(content.base_url ?? '').replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const currentUrl = baseUrl ? `${baseUrl}${currentPath}` : currentPath;
const alternateUrl =
  alternateRaceListHref && baseUrl ? `${baseUrl}${alternateRaceListHref}` : alternateRaceListHref;
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/common_images/logo.svg" type="image/svg+xml" />
    <title>{title}</title>
    {!disableCanonical && baseUrl && <link rel="canonical" href={currentUrl} />}
    {
      alternateUrl && (
        <link rel="alternate" hreflang={locale === 'en' ? 'sv' : 'en'} href={alternateUrl} />
      )
    }
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    <script is:inline set:html={`window.__MARKET_ROUTE_TARGETS__ = ${marketRouteTargetsJson};`} />
    <slot name="head" />
    <NewsletterPopupConfig country={country} locale={locale} content={content} />
  </head>
  <body class="race-list-page v2-race-list loaded">
    <div id="page-wrapper">
      <main>
        <SiteHeader
          country={country}
          locale={locale}
          content={content}
          alternateRaceListHref={alternateRaceListHref}
          raceListPage={true}
        />
        <slot />
      </main>
      <SiteFooter country={country} locale={locale} content={content} />
    </div>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

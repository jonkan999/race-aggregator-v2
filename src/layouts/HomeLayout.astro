---
import '../styles/fonts.css';
import SeoHead from '../components/SeoHead.astro';
import { fitMetaDescription } from '../lib/seoMeta.js';
import '../styles/legacy/legacy-race-list.css';
import '../styles/home.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import GoogleAdsConsent from '../components/GoogleAdsConsent.astro';
import NewsletterPopupConfig from '../components/NewsletterPopupConfig.astro';
import NewsletterPopup from '../components/NewsletterPopup';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { IndexYaml } from '../lib/content';
import type { NewsletterPopupContext } from '../lib/newsletterPopup';

type LayoutLocale = 'native' | 'en';

interface Props {
  title: string;
  description?: string;
  lang: string;
  country: string;
  locale: LayoutLocale;
  content: IndexYaml;
  alternateHref?: string;
  noindex?: boolean;
  disableCanonical?: boolean;
}

const {
  title,
  description = '',
  lang,
  country,
  locale,
  content,
  alternateHref,
  noindex = false,
  disableCanonical = false,
} = Astro.props;
const baseUrl = String(content.base_url ?? '').replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const currentUrl = baseUrl ? `${baseUrl}${currentPath}` : currentPath;
const alternateUrl = alternateHref && baseUrl ? `${baseUrl}${alternateHref}` : alternateHref;
const siteName = String(content.page_name ?? '').trim();
const siteRoot = baseUrl ? `${baseUrl}/` : '/';
const websiteId = `${siteRoot}#website`;
const organizationId = `${siteRoot}#organization`;
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: siteName || title,
      url: siteRoot,
      inLanguage: lang,
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteName || title,
      url: siteRoot,
      logo: {
        '@type': 'ImageObject',
        url: baseUrl ? `${baseUrl}/common_images/logo512.png` : '/common_images/logo512.png',
        width: 512,
        height: 512,
      },
    },
    {
      '@type': 'WebPage',
      name: title,
      description,
      url: currentUrl,
      inLanguage: lang,
      isPartOf: { '@id': websiteId },
    },
  ],
});
const metaDescription = fitMetaDescription(description, [title, String(content.page_name ?? '')]);
const newsletterContext: NewsletterPopupContext = {
  surface: 'race-list',
  kind: 'race-list',
  heading: title,
};
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" href="/common_images/logo.svg" type="image/svg+xml" />
    <title>{title}</title>
    <SeoHead country={country} locale={locale} content={content} title={title} description={metaDescription} currentUrl={currentUrl} alternateUrl={alternateUrl} disableCanonical={disableCanonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <GoogleAdsConsent />
    <script type="application/ld+json" set:html={pageSchema} />
    <slot name="head" />
    <NewsletterPopupConfig country={country} locale={locale} content={content} />
  </head>
  <body class="home-page loaded">
    <div id="page-wrapper">
      <main>
        <SiteHeader
          country={country}
          locale={locale}
          content={content}
          alternateRaceListHref={alternateHref}
        />
        <slot />
      </main>
      <SiteFooter country={country} locale={locale} content={content} />
    </div>
    <NewsletterPopup client:load context={newsletterContext} />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

---
import '../styles/legacy/legacy-race-list.css';
import '../styles/home.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { IndexYaml } from '../lib/content';

type LayoutLocale = 'native' | 'en';

interface Props {
  title: string;
  description?: string;
  lang: string;
  country: string;
  locale: LayoutLocale;
  content: IndexYaml;
  alternateHref?: string;
  noindex?: boolean;
  disableCanonical?: boolean;
}

const {
  title,
  description = '',
  lang,
  country,
  locale,
  content,
  alternateHref,
  noindex = false,
  disableCanonical = false,
} = Astro.props;
const baseUrl = String(content.base_url ?? '').replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const currentUrl = baseUrl ? `${baseUrl}${currentPath}` : currentPath;
const alternateUrl = alternateHref && baseUrl ? `${baseUrl}${alternateHref}` : alternateHref;
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: currentUrl,
  inLanguage: lang,
});
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/common_images/logo.svg" type="image/svg+xml" />
    <title>{title}</title>
    {!disableCanonical && baseUrl && <link rel="canonical" href={currentUrl} />}
    {
      alternateUrl && (
        <link rel="alternate" hreflang={locale === 'en' ? 'sv' : 'en'} href={alternateUrl} />
      )
    }
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={pageSchema} />
    <slot name="head" />
  </head>
  <body class="home-page loaded">
    <div id="page-wrapper">
      <main>
        <SiteHeader
          country={country}
          locale={locale}
          content={content}
          alternateRaceListHref={alternateHref}
        />
        <slot />
      </main>
      <SiteFooter country={country} locale={locale} content={content} />
    </div>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

---
import type { IndexYaml } from '../lib/content';
import { localeBasePrefix, slugify, hasEnglishMerge } from '../lib/content';
import { auxiliaryPageHref, type AuxiliaryPageKey } from '../lib/auxiliaryPages';
import HeaderAuth from './HeaderAuth';

type Locale = 'native' | 'en';

interface Props {
  country: string;
  locale: Locale;
  content: IndexYaml;
  /** Full path to the race list in the other locale (for example `/en/race-calendar/`). */
  alternateRaceListHref?: string;
  raceListPage?: boolean;
}

const { country, locale, content, alternateRaceListHref, raceListPage = false } = Astro.props;

const prefix = localeBasePrefix(country, locale);
const homeHref = prefix;

function navHref(segment: string): string {
  return `${prefix}${segment}`;
}

function pageKeyForNavKey(key: string): AuxiliaryPageKey | null {
  switch (key) {
    case 'add-race':
    case 'measure-route':
    case 'training-plans':
    case 'pace-calculator':
    case 'racetime-estimator':
    case 'about-us':
    case 'contact':
      return key;
    default:
      return null;
  }
}

const nav = content.navigation ?? {};
const cc = content.country_code ?? country;
const altText = String(content.alternate_locale_link_text ?? '');
const accessibility = (content.accessibility ?? {}) as Record<string, string>;
const showAltLink =
  altText &&
  alternateRaceListHref &&
  (locale === 'native' ? hasEnglishMerge(country) : true);
const altHref = alternateRaceListHref ?? '';
const authBase = `${prefix}auth`;
const authModal = (content.auth_modal ?? {}) as Record<string, string>;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const supportedNavKeys = new Set([
  'main',
  'race-list',
  'add-race',
  'measure-route',
  'training-plans',
  'pace-calculator',
  'racetime-estimator',
  'about-us',
  'contact',
]);

function normalizePath(path: string): string {
  return path.replace(/\/+$/, '') || '/';
}

function isActiveNavPath(targetHref: string, key: string): boolean {
  const normalizedHref = normalizePath(targetHref);

  if (key === 'main') {
    return currentPath === normalizedHref;
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}
---

<section
  class:list={[
    'section-header-menu',
    raceListPage && 'header-menu--inline',
  ]}
>
  <div class="upper-header">
    <a href={homeHref} class="logo-container">
      <img
        class="logo-image"
        src="/common_images/logo100px.jpg"
        alt=""
        width="100"
        height="100"
      />
    </a>
    <a class="home-link" href={homeHref}>
      <h2 class="page-name new-amsterdam">{content.page_name}</h2>
    </a>
    <HeaderAuth
      client:load
      siteKey={`${content.country_code ?? country}:${content.page_name ?? 'site'}`}
      siteName={String(content.page_name ?? 'Site')}
      countryCode={country}
      locale={locale}
      signInLabel={String(authModal.title_sign_in ?? '')}
      confirmUrl={`${authBase}/confirm/`}
      resetPasswordUrl={`${authBase}/reset-password/`}
      messages={{
        titleSignIn: String(authModal.title_sign_in ?? ''),
        titleCreateAccount: String(authModal.title_create_account ?? ''),
        titleResetPassword: String(authModal.title_reset_password ?? ''),
        namePlaceholder: String(authModal.name_placeholder ?? ''),
        emailPlaceholder: String(authModal.email_placeholder ?? ''),
        passwordPlaceholder: String(authModal.password_placeholder ?? ''),
        submitSignIn: String(authModal.submit_sign_in ?? ''),
        submitCreateAccount: String(authModal.submit_create_account ?? ''),
        submitResetPassword: String(authModal.submit_reset_password ?? ''),
        createAccount: String(authModal.create_account ?? ''),
        forgotPassword: String(authModal.forgot_password ?? ''),
        backToLogin: String(authModal.back_to_login ?? ''),
        errorWrongPassword: String(authModal.error_wrong_password ?? ''),
        errorEmailNotFound: String(authModal.error_email_not_found ?? ''),
        alreadyLoggedIn: String(authModal.already_logged_in ?? ''),
        asEmail: String(authModal.as_email ?? ''),
        continueAsUser: String(authModal.continue_as_user ?? ''),
        logoutAndSwitch: String(authModal.logout_and_switch ?? ''),
        accountCreated: String(authModal.account_created ?? ''),
        accountCreatedDetails: String(authModal.account_created_details ?? ''),
        verificationEmailSent: String(authModal.verification_email_sent ?? ''),
        pleaseVerify: String(authModal.please_verify ?? ''),
        errorInvalidCredential: String(authModal.error_invalid_credential ?? ''),
        createAccountPrompt: String(authModal.create_account_prompt ?? ''),
        errorTooManyRequests: String(authModal.error_too_many_requests ?? ''),
        authUnavailable: String(authModal.auth_unavailable ?? ''),
        passwordResetSent: String(
          (content.submission_flow as Record<string, string> | undefined)?.password_reset_sent ?? '',
        ),
        continueWithGoogle: String(authModal.continue_with_google ?? ''),
        continueWithGoogleCreate: String(authModal.continue_with_google_create ?? ''),
        googleInProgress: String(authModal.google_in_progress ?? ''),
        oauthDivider: String(authModal.oauth_divider ?? ''),
      }}
    />
  </div>
  <nav
    class="main-nav-container right-scroller"
    aria-label={String(accessibility.main_navigation_label ?? '')}
    data-header-nav
  >
    {
      Object.entries(nav).map(([key, value]) => {
        if (typeof value !== 'string') return null;
        if (!supportedNavKeys.has(key)) return null;
        if (key === 'main') {
          const isActive = isActiveNavPath(homeHref, key);
          return (
            <a
              class:list={['nav-container', isActive && 'active']}
              href={homeHref}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="nav-item">{value}</span>
            </a>
          );
        }
        const pageKey = pageKeyForNavKey(key);
        const href = pageKey
          ? auxiliaryPageHref({ country, locale, content, pageKey })
          : navHref(slugify(value, cc));
        const isActive = isActiveNavPath(href, key);
        return (
          <a
            class:list={['nav-container', isActive && 'active']}
            href={href}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="nav-item">{value}</span>
          </a>
        );
      })
    }
    <a
      class:list={['nav-container', isActiveNavPath(navHref('privacy'), 'privacy') && 'active']}
      href={navHref('privacy')}
      aria-current={isActiveNavPath(navHref('privacy'), 'privacy') ? 'page' : undefined}
    >
      <span class="nav-item">{(content.footer as { privacy?: string } | undefined)?.privacy}</span>
    </a>
    {
      showAltLink ? (
        <div class="language-selector-nav">
        <svg class="language-flag nav-flag" aria-label="no"><use href="/icons/svg-sprite.svg#flag-en" xlink:href="/icons/svg-sprite.svg#flag-no"></use></svg>
          <a class="nav-container language-switch-link" href={altHref}>
            <span class="nav-item">{altText}</span>
          </a>
        </div>
      ) : null
    }
  </nav>
</section>

<script is:inline>
  function scrollActiveHeaderNavIntoView() {
    const nav = document.querySelector('[data-header-nav]');
    const activeItem = nav?.querySelector('.nav-container.active');
    if (!(activeItem instanceof HTMLElement)) return;

    window.requestAnimationFrame(() => {
      activeItem.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scrollActiveHeaderNavIntoView, { once: true });
  } else {
    scrollActiveHeaderNavIntoView();
  }
</script>

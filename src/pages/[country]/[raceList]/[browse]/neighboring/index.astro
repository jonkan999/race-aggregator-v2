---
import BrowseLayout from '../../../../../layouts/BrowseLayout.astro';
import {
  hasEnglishMerge,
  listCountryCodes,
  loadIndexYaml,
  raceListSlug,
  type Locale,
} from '../../../../../lib/content';
import { slugify } from '../../../../../lib/slugify';
import {
  BROWSE_NEIGHBORING_SEGMENT,
  getBrowseCategoriesIndexHref,
  getBrowseNeighboringEntries,
  getBrowseNeighboringIndexHref,
  getBrowseOverviewHref,
} from '../../../../../lib/raceBrowse';

export function getStaticPaths() {
  return listCountryCodes().filter((country) => country !== 'se').map((country) => {
    const content = loadIndexYaml(country, 'native');
    return {
      params: {
        country,
        raceList: raceListSlug(content, country),
        browse: slugify(String(content.browse_by_category?.button ?? 'browse-by-category'), country),
      },
    };
  });
}

const { country, raceList, browse } = Astro.params;
const locale: Locale = 'native';
const content = loadIndexYaml(country, locale);
const expectedRaceList = raceListSlug(content, country);
const expectedBrowse = slugify(String(content.browse_by_category?.button ?? 'browse-by-category'), country);

if (raceList !== expectedRaceList || browse !== expectedBrowse) {
  return Astro.redirect(`/${country}/${expectedRaceList}/${expectedBrowse}/${BROWSE_NEIGHBORING_SEGMENT}/`, 301);
}
return Astro.redirect(getBrowseNeighboringIndexHref(country, locale, content), 301);

const overviewHref = getBrowseOverviewHref(country, locale, content);
const categoriesHref = getBrowseCategoriesIndexHref(country, locale, content);
const neighboringHref = getBrowseNeighboringIndexHref(country, locale, content);
const neighboringEntries = await getBrowseNeighboringEntries({ countryCode: country, locale, content });
const title = String(content.browse_neighboring?.title ?? content.browse_by_category?.neighboring ?? 'Närliggande länder');
const description = String(content.browse_neighboring?.meta_description ?? '');
const alternateRaceListHref = hasEnglishMerge(country)
  ? getBrowseNeighboringIndexHref(country, 'en', loadIndexYaml(country, 'en'))
  : undefined;
---

<BrowseLayout
  title={`${title} — ${content.page_name ?? ''}`}
  description={description}
  lang={String(content.country_language_code ?? 'sv')}
  country={country}
  locale="native"
  content={content}
  alternateRaceListHref={alternateRaceListHref}
  activeTab="neighboring"
  overviewHref={overviewHref}
  categoriesHref={categoriesHref}
  neighboringHref={neighboringHref}
  breadcrumbs={[
    { label: String(content.browse_by_category?.overview ?? content.browse_overview?.title ?? 'Bläddra efter kategori'), href: overviewHref },
    { label: title },
  ]}
>
  <section class="browse-intro">
    <h1 class="browse-intro__title">{title}</h1>
    <p class="browse-intro__description">{description}</p>
  </section>

  <div class="browse-grid">
    {
      neighboringEntries.map((entry) => (
        <a href={entry.href} class="browse-card">
          <h2 class="browse-card__title">
            <span>{entry.label}</span>
            <span class="browse-card__count">{entry.count}</span>
          </h2>
        </a>
      ))
    }
  </div>
</BrowseLayout>

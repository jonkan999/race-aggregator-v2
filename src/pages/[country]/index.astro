---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  listCountryCodes,
  loadIndexYaml,
  raceListSlug,
  type Locale,
} from '../../lib/content';

export function getStaticPaths() {
  return listCountryCodes().map((country) => ({ params: { country } }));
}

const { country } = Astro.params;
const locale: Locale = 'native';
const content = loadIndexYaml(country, locale);
const listSlug = raceListSlug(content, country);
const raceListNav = content.navigation?.['race-list'] ?? 'Races';
const title = `${content.page_name ?? 'Race calendar'} — ${content.country_native ?? country}`;
const desc = content.meta_description ?? '';
---

<BaseLayout title={title} description={desc} lang={content.country_language_code ?? 'sv'}>
  <main style="max-width: 40rem; margin: 2rem auto; padding: 0 1rem;">
    <h1>{content.page_name}</h1>
    <p>{content.description}</p>
    <p>
      <a href={`/${country}/${listSlug}/`}>{raceListNav}</a>
    </p>
  </main>
</BaseLayout>

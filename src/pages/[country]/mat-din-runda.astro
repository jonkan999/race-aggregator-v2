---
import AuxiliaryLayout from '../../layouts/AuxiliaryLayout.astro';
import AuxiliaryPageIntro from '../../components/AuxiliaryPageIntro.astro';
import MeasureRouteIsland from '../../components/MeasureRouteIsland';
import { alternateAuxiliaryPageHref, auxiliaryStaticPaths } from '../../lib/auxiliaryPages';
import { loadIndexYaml, type Locale } from '../../lib/content';

export function getStaticPaths() {
  return auxiliaryStaticPaths('native');
}

const { country } = Astro.params;
const locale: Locale = 'native';
const content = loadIndexYaml(country, locale);
const pageTitle = String(content.measure_route_title ?? content.navigation?.['measure-route'] ?? 'Mät din runda');
const title = `${pageTitle} | ${content.page_name ?? 'Loppkartan'}`;
const description = String(content.measure_route_description ?? '');
const alternateHref = alternateAuxiliaryPageHref({ country, locale, pageKey: 'measure-route' });
const center = (content.mapbox_center ?? {}) as { latitude?: number; longitude?: number };
const fallbackZoom = Number.parseInt(String(content.race_page_map_zoom ?? content.mapbox_zoom ?? '6'), 10);
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang={content.country_language_code ?? 'sv'}
  country={country}
  locale={locale}
  content={content}
  alternateHref={alternateHref}
  breadcrumbLabel={pageTitle}
  schemaType="WebApplication"
>
  <section class="section-measure-route">
    <div class="container">
      <AuxiliaryPageIntro title={pageTitle} description={description} />
      <MeasureRouteIsland
        client:load
        mapboxToken={import.meta.env.PUBLIC_MAPBOX_TOKEN ?? ''}
        centerLat={Number(center.latitude ?? 62.0)}
        centerLng={Number(center.longitude ?? 15.0)}
        zoom={Number.isFinite(fallbackZoom) ? fallbackZoom : 6}
        removeLastLabel={String(content.remove_last_point ?? '')}
        clearRouteLabel={String(content.clear_route ?? '')}
        totalDistanceLabel={String(content.total_distance ?? '')}
        mapNotConfiguredMessage={String(content.map_not_configured ?? '')}
      />
    </div>
  </section>
</AuxiliaryLayout>

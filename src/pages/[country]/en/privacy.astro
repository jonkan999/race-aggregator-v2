---
import AuxiliaryLayout from '../../../layouts/AuxiliaryLayout.astro';
import { alternateAuxiliaryPageHref, auxiliaryStaticPaths } from '../../../lib/auxiliaryPages';
import { loadIndexYaml, type Locale } from '../../../lib/content';

export function getStaticPaths() {
  return auxiliaryStaticPaths('en');
}

const { country } = Astro.params;
const locale: Locale = 'en';
const content = loadIndexYaml(country, locale);
const privacy = content.privacy_page ?? {};
const pageTitle = String(privacy.title ?? content.footer?.privacy ?? 'Privacy Policy');
const title = `${pageTitle} | ${content.page_name ?? 'Loppkartan'}`;
const description = String(privacy.meta_description ?? '');
const alternateHref = alternateAuxiliaryPageHref({ country, locale, pageKey: 'privacy' });
const sections = Array.isArray(privacy.sections) ? privacy.sections : [];
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang={content.country_language_code ?? 'en'}
  country={country}
  locale={locale}
  content={content}
  alternateHref={alternateHref}
  breadcrumbLabel={pageTitle}
>
  <section class="section-privacy">
    <div class="container">
      <h1>{pageTitle}</h1>
      <div class="privacy-content">
        <div class="last-updated">
          {String(privacy.last_updated_label ?? '')}: {String(privacy.last_updated_date ?? '')}
        </div>

        {sections.map((section) => (
          <div class="privacy-section">
            <h2>{String(section.title ?? '')}</h2>
            <p>{String(section.intro ?? '')}</p>
            {Array.isArray(section.bullets) && section.bullets.length > 0 ? (
              <ul>
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            ) : null}
          </div>
        ))}

        <div class="privacy-section">
          <p>{String(privacy.contact_intro ?? '')}</p>
          <a href={`mailto:${String(privacy.contact_email ?? '')}`}>{String(privacy.contact_email ?? '')}</a>
        </div>
      </div>
    </div>
  </section>
</AuxiliaryLayout>

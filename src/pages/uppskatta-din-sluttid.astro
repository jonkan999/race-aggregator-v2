---
import AuxiliaryLayout from '../layouts/AuxiliaryLayout.astro';
import AuxiliaryPageIntro from '../components/AuxiliaryPageIntro.astro';
import RaceTimeEstimatorIsland from '../components/RaceTimeEstimatorIsland';
import { alternateAuxiliaryPageHref } from '../lib/auxiliaryPages';
import { loadIndexYaml, type Locale } from '../lib/content';
import lookupData from '../data/tools/lookupTable.json';

const country = 'se';
const locale: Locale = 'native';
const content = loadIndexYaml(country, locale);
const pageTitle = String(content.racetime_estimator_title ?? content.navigation?.['racetime-estimator'] ?? 'Uppskatta din sluttid');
const title = [pageTitle, String(content.page_name ?? '')].filter(Boolean).join(' | ');
const description = String(content.racetime_estimator_description ?? '');
const alternateHref = alternateAuxiliaryPageHref({ country, locale, pageKey: 'racetime-estimator' });
const halfMarathonLabel = String(content.pace_table_header_half ?? 'Halvmarathon');
const marathonLabel = String(content.pace_table_header_full ?? 'Maraton');
const lookupTable = Array.isArray((lookupData as { data?: unknown[] }).data)
  ? (lookupData as { data: Array<{ input_distance: number; input_time: number; predictions: Array<{ distance: number; pace: number }> }> }).data
  : [];
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang={content.country_language_code ?? 'sv'}
  country={country}
  locale={locale}
  content={content}
  alternateHref={alternateHref}
  breadcrumbLabel={pageTitle}
  schemaType="WebApplication"
>
  <section class="section-race-estimator">
    <div class="container">
      <AuxiliaryPageIntro title={pageTitle} description={description} />
      <RaceTimeEstimatorIsland
        client:load
        lookupTable={lookupTable}
        knownDistanceLabel={String(content.known_distance_label ?? '')}
        knownTimeLabel={String(content.known_time_label ?? '')}
        calculateButtonText={String(content.calculate_button_text ?? '')}
        predictedTimesTitle={String(content.predicted_times_title ?? '')}
        distanceHeader={String(content.distance_header ?? '')}
        finishTimeHeader={String(content.finish_time_header ?? '')}
        pacePerKmHeader={String(content.pace_per_km_header ?? '')}
        pacePerMileHeader={String(content.pace_per_mile_header ?? '')}
        hillyCourseLabel={String(content.hilly_course_label ?? '')}
        halfMarathonLabel={halfMarathonLabel}
        marathonLabel={marathonLabel}
      />
    </div>
  </section>
</AuxiliaryLayout>

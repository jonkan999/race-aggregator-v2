---
import BrowseLayout from '../../../../layouts/BrowseLayout.astro';
import {
  loadIndexYaml,
  raceListSlug,
} from '../../../../lib/content';
import { slugify } from '../../../../lib/slugify';
import {
  getBrowseCategoryEntries,
  getBrowseCategoriesIndexHref,
  getBrowseNeighboringIndexHref,
  getBrowseOverviewData,
  getBrowseOverviewHref,
  getScopedRaceTypeEntries,
  getTypeCategoryNavigationEntries,
} from '../../../../lib/raceBrowse';
import { getAllRaceListRows } from '../../../../lib/raceListSsg';
import { isDomesticOrigin } from '../../../../lib/neighboringSelection';
import { filterRowsToUpcomingWindow } from '../../../../lib/upcomingRaceWindow';

export function getStaticPaths() {
  const country = (process.env.MARKET_CODE ?? 'se').trim().toLowerCase();
  const content = loadIndexYaml(country, 'en');
  return [{
    params: {
      raceList: raceListSlug(content, country),
      browse: slugify(String(content.browse_by_category?.button ?? 'browse-by-category'), country),
    },
  }];
}

const country = (process.env.MARKET_CODE ?? 'se').trim().toLowerCase();
const { raceList, browse } = Astro.params;
const content = loadIndexYaml(country, 'en');
const expectedRaceList = raceListSlug(content, country);
const expectedBrowse = slugify(String(content.browse_by_category?.button ?? 'browse-by-category'), country);

if (raceList !== expectedRaceList || browse !== expectedBrowse) {
  return Astro.redirect(`/en/${expectedRaceList}/${expectedBrowse}/`, 301);
}

const overviewHref = getBrowseOverviewHref(country, 'en', content);
const categoriesHref = getBrowseCategoriesIndexHref(country, 'en', content);
const neighboringHref = getBrowseNeighboringIndexHref(country, 'en', content);
const overviewData = await getBrowseOverviewData({ countryCode: country, locale: 'en', content });
const categoryEntries = await getBrowseCategoryEntries({ countryCode: country, locale: 'en', content });
const domesticUpcomingRows = filterRowsToUpcomingWindow(
  (await getAllRaceListRows(country)).rows.filter((row) => isDomesticOrigin(row.origin_country, country)),
);

const countyCards = await Promise.all(
  overviewData.counties.slice(0, 12).map(async (entry) => {
    const rows = domesticUpcomingRows.filter(
      (row) => (row.county?.trim().toLowerCase() ?? '') === entry.key.trim().toLowerCase(),
    );
    return {
      ...entry,
      chips: getScopedRaceTypeEntries({
        rows,
        countryCode: country,
        locale: 'en',
        content,
        scopeKind: 'county',
        scopeLabel: entry.label,
        scopeHref: entry.href,
      }).slice(0, 4),
    };
  }),
);

const typeCards = await Promise.all(
  overviewData.types.slice(0, 12).map(async (entry) => {
    const rows = domesticUpcomingRows.filter(
      (row) => (row.race_type?.trim().toLowerCase() ?? '') === entry.key.trim().toLowerCase(),
    );
    return {
      ...entry,
      chips: getTypeCategoryNavigationEntries({
        rows,
        countryCode: country,
        locale: 'en',
        content,
        raceTypeKey: entry.key,
      }).slice(0, 4),
    };
  }),
);

const monthCards = await Promise.all(
  overviewData.months.map(async (entry) => {
    const monthNumber = Number.parseInt(entry.key, 10);
    const rows = domesticUpcomingRows.filter((row) =>
      Array.isArray(row.race_dates)
        ? row.race_dates.some(
            (raceDate) =>
              Array.isArray(raceDate) &&
              typeof raceDate[0] === 'string' &&
              Number.parseInt(raceDate[0].slice(4, 6), 10) === monthNumber,
          )
        : false,
    );
    return {
      ...entry,
      chips: getScopedRaceTypeEntries({
        rows,
        countryCode: country,
        locale: 'en',
        content,
        scopeKind: 'month',
        scopeLabel: entry.label,
        scopeHref: entry.href,
      }).slice(0, 4),
    };
  }),
);

const title = String(content.browse_overview?.title ?? content.browse_by_category?.overview ?? '');
const description = String(content.browse_overview?.meta_description ?? '');
const alternateRaceListHref = getBrowseOverviewHref(country, 'native', loadIndexYaml(country, 'native'));
---

<BrowseLayout
  title={`${title} — ${content.page_name ?? ''}`}
  description={description}
  lang="en"
  country={country}
  locale="en"
  content={content}
  alternateRaceListHref={alternateRaceListHref}
  activeTab="overview"
  overviewHref={overviewHref}
  categoriesHref={categoriesHref}
  neighboringHref={neighboringHref}
  breadcrumbs={[
    { label: String(content.browse_by_category?.overview ?? content.browse_overview?.title ?? '') },
  ]}
>
  <section class="browse-intro">
    <h1 class="browse-intro__title">{title}</h1>
    <p class="browse-intro__description">{description}</p>
  </section>

  <section class="browse-grid-section">
    <h2 class="browse-grid-section__title">{String(content.browse_by_category?.counties ?? 'Regions')}</h2>
    <p class="browse-grid-section__description">{String(content.browse_counties?.meta_description ?? '')}</p>
    <div class="browse-grid">
      {
        countyCards.map((entry) => (
          <div class="browse-card browse-card--static">
            <h3 class="browse-card__title">
              <a href={entry.href}>{entry.label}</a>
              <span class="browse-card__count">{entry.count}</span>
            </h3>
            {
              entry.chips.length > 0 && (
                <div class="browse-card__links">
                  {entry.chips.map((chip) => (
                    <a href={chip.href} class="browse-card__chip">
                      {chip.label}
                      <span class="browse-card__chip-count">{chip.count}</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        ))
      }
    </div>
  </section>

  <section class="browse-grid-section">
    <h2 class="browse-grid-section__title">{String(content.browse_by_category?.cities ?? 'Cities')}</h2>
    <p class="browse-grid-section__description">{String(content.browse_cities?.meta_description ?? '')}</p>
    <div class="browse-grid">
      {
        overviewData.cities.map((entry) => (
          <a href={entry.href} class="browse-card">
            <h3 class="browse-card__title">
              <span>{entry.label}</span>
              <span class="browse-card__count">{entry.count}</span>
            </h3>
          </a>
        ))
      }
    </div>
  </section>

  <section class="browse-grid-section">
    <h2 class="browse-grid-section__title">{String(content.browse_by_category?.neighboring ?? '')}</h2>
    <div class="browse-grid">
      {
        overviewData.neighboring.map((entry) => (
          <a href={entry.href} class="browse-card">
            <h3 class="browse-card__title">
              <span>{entry.label}</span>
              <span class="browse-card__count">{entry.count}</span>
            </h3>
          </a>
        ))
      }
    </div>
  </section>

  <section class="browse-grid-section">
    <h2 class="browse-grid-section__title">{String(content.browse_by_category?.types ?? 'Types')}</h2>
    <p class="browse-grid-section__description">{String(content.browse_types?.meta_description ?? '')}</p>
    <div class="browse-grid">
      {
        typeCards.map((entry) => (
          <div class="browse-card browse-card--static">
            <h3 class="browse-card__title">
              <a href={entry.href}>{entry.label}</a>
              <span class="browse-card__count">{entry.count}</span>
            </h3>
            {
              entry.chips.length > 0 && (
                <div class="browse-card__links">
                  {entry.chips.map((chip) => (
                    <a href={chip.href} class="browse-card__chip">
                      {chip.label}
                      <span class="browse-card__chip-count">{chip.count}</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        ))
      }
    </div>
  </section>

  <section class="browse-grid-section">
    <h2 class="browse-grid-section__title">{String(content.browse_categories?.title ?? content.browse_by_category?.categories ?? '')}</h2>
    <p class="browse-grid-section__description">{String(content.browse_categories?.meta_description ?? '')}</p>
    <div class="browse-grid">
      {
        categoryEntries.map((entry) => (
          <div class="browse-card browse-card--static">
            <h3 class="browse-card__title">
              <a href={entry.href}>{entry.label}</a>
              <span class="browse-card__count">{entry.count}</span>
            </h3>
            <p class="browse-card__meta">{content.browse_categories?.meta_description}</p>
            {
              entry.topTypes.length > 0 && (
                <div class="browse-card__links">
                  {entry.topTypes.slice(0, 4).map((chip) => (
                    <a href={chip.href} class="browse-card__chip">
                      {chip.label}
                      <span class="browse-card__chip-count">{chip.count}</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        ))
      }
    </div>
  </section>

  <section class="browse-grid-section">
    <h2 class="browse-grid-section__title">{String(content.browse_by_category?.months ?? 'Months')}</h2>
    <p class="browse-grid-section__description">{String(content.browse_months?.meta_description ?? '')}</p>
    <div class="browse-grid">
      {
        monthCards.map((entry) => (
          <div class="browse-card browse-card--static">
            <h3 class="browse-card__title">
              <a href={entry.href}>{entry.label}</a>
              <span class="browse-card__count">{entry.count}</span>
            </h3>
            {
              entry.chips.length > 0 && (
                <div class="browse-card__links">
                  {entry.chips.map((chip) => (
                    <a href={chip.href} class="browse-card__chip">
                      {chip.label}
                      <span class="browse-card__chip-count">{chip.count}</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        ))
      }
    </div>
  </section>
</BrowseLayout>

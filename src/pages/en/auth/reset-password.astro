---
import AuxiliaryLayout from '../../../layouts/AuxiliaryLayout.astro';
import '../../../styles/auth-pages.css';
import { loadIndexYaml, type Locale } from '../../../lib/content';

const country = 'se';
const locale: Locale = 'en';
const content = loadIndexYaml(country, locale);
const auth = (content.auth_modal ?? {}) as Record<string, string>;
const authPages = (content.auth_pages ?? {}) as Record<string, string>;
const title = `${String(auth.title_reset_password ?? 'Reset password')} | ${content.page_name ?? 'Loppkartan'}`;
const description = String(auth.title_reset_password ?? '');
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang={content.country_language_code ?? 'en'}
  country={country}
  locale={locale}
  content={content}
  breadcrumbLabel={String(auth.title_reset_password ?? 'Reset password')}
>
  <section class="auth-page-section">
    <div class="container">
      <div class="auth-page-card">
        <h1>{String(auth.title_reset_password ?? 'Reset password')}</h1>
        <p id="reset-copy">{String(authPages.reset_intro ?? 'Enter a new password for your account.')}</p>

        <form id="reset-password-form">
          <div>
            <label for="password">{String(auth.password_placeholder ?? 'Password')}</label>
            <input type="password" id="password" required minlength="6" />
          </div>
          <div>
            <label for="confirm-password">{String(authPages.reset_confirm_label ?? 'Confirm password')}</label>
            <input type="password" id="confirm-password" required />
          </div>
          <button type="submit">{String(auth.submit_reset_password ?? 'Send reset link')}</button>
        </form>

        <p class="auth-page-error" id="reset-error" hidden></p>
        <p class="auth-page-success" id="reset-success" hidden></p>
      </div>
    </div>
  </section>
</AuxiliaryLayout>

<script define:vars={{
  resetMismatchError: String(authPages.reset_mismatch_error ?? 'Passwords do not match.'),
  resetInvalidLinkError: String(authPages.reset_invalid_link_error ?? 'Invalid or missing recovery link.'),
  resetSuccess: String(authPages.reset_success ?? 'Your password has been updated. You can now sign in.'),
}}>
  import { getSupabaseBrowserClient, isSupabaseConfigured } from '../../../lib/supabase';

  if (typeof window !== 'undefined' && isSupabaseConfigured()) {
    const supabase = getSupabaseBrowserClient();
    const form = document.getElementById('reset-password-form');
    const error = document.getElementById('reset-error');
    const success = document.getElementById('reset-success');
    const hashParams = new URLSearchParams(window.location.hash.substring(1));

    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (error) error.hidden = true;
        if (success) success.hidden = true;

        const password = /** @type {HTMLInputElement} */ (document.getElementById('password')).value;
        const confirmPassword = /** @type {HTMLInputElement} */ (document.getElementById('confirm-password')).value;

        if (password !== confirmPassword) {
          if (error) {
            error.hidden = false;
            error.textContent = resetMismatchError;
          }
          return;
        }

        const type = hashParams.get('type');
        if (type !== 'recovery') {
          if (error) {
            error.hidden = false;
            error.textContent = resetInvalidLinkError;
          }
          return;
        }

        const { error: updateError } = await supabase.auth.updateUser({ password });
        if (updateError) {
          if (error) {
            error.hidden = false;
            error.textContent = updateError.message;
          }
          return;
        }

        if (success) {
          success.hidden = false;
          success.textContent = resetSuccess;
        }
      });
    }
  }
</script>

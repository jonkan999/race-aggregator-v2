---
import '../../styles/add-race.css';
import AuxiliaryLayout from '../../layouts/AuxiliaryLayout.astro';
import AddRaceFormIsland from '../../components/AddRaceFormIsland';
import { alternateAuxiliaryPageHref } from '../../lib/auxiliaryPages';
import { loadIndexYaml, slugify, type Locale } from '../../lib/content';

const country = 'se';
const locale: Locale = 'en';
const content = loadIndexYaml(country, locale);
const pageTitle = String(content.add_race_title ?? content.navigation?.['add-race'] ?? 'Add race');
const title = [pageTitle, String(content.page_name ?? '')].filter(Boolean).join(' | ');
const description = String(content.add_race_meta_description ?? '');
const alternateHref = alternateAuxiliaryPageHref({ country, locale, pageKey: 'add-race' });
const center = (content.mapbox_center ?? {}) as { latitude?: number; longitude?: number };
const fallbackZoom = Number.parseInt(String(content.mapbox_zoom ?? '6'), 10);
const baseUrl = String(content.base_url ?? '');
let siteKey = slugify(String(content.page_name ?? country), country);
try {
  siteKey = new URL(baseUrl).hostname.replace(/^www\./, '') || siteKey;
} catch {
  // Fall back to the YAML-driven page name slug if base_url is missing or invalid.
}
const typeOptions = Object.entries((content.type_options ?? {}) as Record<string, string>).map(
  ([value, label]) => ({ value, label: String(label) }),
);
const quickDistances = [
  { value: '21.1', label: String(content.half_marathon_button ?? 'Half Marathon') },
  { value: '42.2', label: String(content.marathon_button ?? 'Marathon') },
  { value: 'backyard', label: String(content.backyard_ultra_button ?? 'Backyard Ultra') },
  { value: 'frontyard', label: String(content.frontyard_ultra_button ?? 'Frontyard Ultra') },
  { value: '80.5', label: String(content.fifty_miles_button ?? '50 miles') },
  { value: '160.9', label: String(content.hundred_miles_button ?? '100 miles') },
];
const contactSegment = slugify(String(content.navigation?.contact ?? ''), country);
const contactHref = `/en/${contactSegment}/`;
const submissionFlow = (content.submission_flow ?? {}) as Record<string, string>;
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang="en"
  country={country}
  locale={locale}
  content={content}
  alternateHref={alternateHref}
  breadcrumbLabel={pageTitle}
  schemaType="WebPage"
>
  <section class="section-add-race">
    <h1 class="section-header">{pageTitle}</h1>
    <AddRaceFormIsland
      client:load
      countryCode={country}
      locale={locale}
      siteKey={siteKey}
      siteName={String(content.page_name ?? '')}
      mapboxToken={import.meta.env.PUBLIC_MAPBOX_TOKEN ?? ''}
      centerLat={Number(center.latitude ?? 62.0)}
      centerLng={Number(center.longitude ?? 15.0)}
      zoom={Number.isFinite(fallbackZoom) ? fallbackZoom : 6}
      labels={{
        name: String(content.name_label ?? ''),
        type: String(content.type_text ?? ''),
        typePlaceholder: String(content.type_select_placeholder ?? ''),
        date: String(content.date_text ?? ''),
        multiDay: String(content.multi_day_toggle ?? ''),
        endDate: String(content.end_date_text ?? ''),
        startTime: String(content.start_time_label ?? ''),
        optional: String(content.optional_label ?? ''),
        mapMessage: String(content.map_message ?? ''),
        place: String(content.place_label ?? ''),
        distance: String(content.distance_label ?? ''),
        distancePlaceholder: String(content.distance_placeholder ?? ''),
        addDistance: String(content.add_distance_button ?? ''),
        organizer: String(content.organizer_label ?? ''),
        organizerContact: String(content.organizer_contact_label ?? ''),
        website: String(content.website_label ?? ''),
        priceRange: String(content.price_range_label ?? ''),
        summary: String(content.add_race_description_label ?? ''),
        additional: String(content.add_race_additional_label ?? ''),
        images: String(content.add_race_images_label ?? ''),
        chooseImages: String(content.choose_pictures_button ?? ''),
        dragDrop: String(content.drag_drop_text ?? ''),
        clearImages: String(content.clear_images_button ?? ''),
        clearForm: String(content.clear_form_button ?? ''),
        submit: String(content.submit_button ?? ''),
        disclaimerLead: String(content.disclaimer_text_3 ?? ''),
        disclaimerLink: String(content.disclaimer_link ?? ''),
        disclaimerTail: String(content.disclaimer_text_4 ?? ''),
        coordinatesPrefix: String(content.coordinates_display_prefix ?? ''),
        removeImage: String(content.add_race_remove_image_label ?? ''),
      }}
      placeholders={{
        name: String(content.name_placeholder ?? ''),
        place: String(content.place_placeholder ?? ''),
        organizer: String(content.organizer_contact_placeholder ?? ''),
        organizerMail: String(content.organizer_mail_placeholder ?? ''),
        website: String(content.website_placeholder ?? ''),
        startTime: String(content.start_time_placeholder ?? ''),
        priceRange: String(content.price_range_placeholder ?? ''),
        summary: String(content.add_race_description_placeholder ?? ''),
        additional: String(content.add_race_additional_placeholder ?? ''),
      }}
      quickDistances={quickDistances}
      raceTypeOptions={typeOptions}
      messages={{
        missingFields: String(submissionFlow.missing_fields ?? ''),
        duplicateRace: String(submissionFlow.race_exists ?? ''),
        submissionFailed: String(submissionFlow.submission_failed ?? ''),
        submissionSuccess: String(submissionFlow.race_submitted ?? ''),
        processing: String(submissionFlow.processing_submission ?? ''),
        uploadLimit: String(content.add_race_upload_limit_message ?? ''),
        mapUnavailable: String(content.add_race_map_not_configured ?? ''),
      }}
      contactHref={contactHref}
    />
  </section>
</AuxiliaryLayout>

---
import AuxiliaryLayout from '../../layouts/AuxiliaryLayout.astro';
import { alternateAuxiliaryPageHref, auxiliaryPageHref } from '../../lib/auxiliaryPages';
import { loadIndexYaml, type Locale } from '../../lib/content';

const country = (process.env.MARKET_CODE ?? 'se').trim().toLowerCase();
const locale: Locale = 'en';
const content = loadIndexYaml(country, locale);
const contact = content.contact ?? {};
const pageTitle = String(contact.title ?? content.navigation?.contact ?? '');
const title = [pageTitle, String(content.page_name ?? '')].filter(Boolean).join(' | ');
const description = String(contact.meta_description ?? contact.content?.intro ?? '');
const alternateHref = alternateAuxiliaryPageHref({ country, locale, pageKey: 'contact' });
const canonicalPath = auxiliaryPageHref({ country, locale, content, pageKey: 'contact' });
const social = Object.entries((content.footer?.social_links ?? {}) as Record<string, string>).filter(([, href]) => Boolean(String(href).trim()));
const socialLabel = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang={content.country_language_code ?? 'en'}
  country={country}
  locale={locale}
  content={content}
  alternateHref={alternateHref}
  canonicalPath={canonicalPath}
  breadcrumbLabel={pageTitle}
  schemaType="ContactPage"
>
  <section class="section-contact">
    <div class="container">
      <h1>{pageTitle}</h1>
      <div class="contact-content">
        <p class="intro">{String(contact.content?.intro ?? '')}</p>

        <div class="contact-methods">
          <div class="contact-method">
            <h3>{String(contact.content?.email?.title ?? '')}</h3>
            <a href={`mailto:${String(contact.content?.email?.address ?? '')}`}>
              {String(contact.content?.email?.address ?? '')}
            </a>
            <p>{String(contact.content?.email?.description ?? '')}</p>
          </div>

          <div class="contact-method">
            <h3>{String(contact.content?.social?.title ?? '')}</h3>
            <p>{String(contact.content?.social?.description ?? '')}</p>
            <div class="aux-social-links">
              {social.map(([key, href]) => (
                <a class="aux-social-link" href={href} target="_blank" rel="noopener noreferrer">
                  {socialLabel(key)}
                </a>
              ))}
            </div>
          </div>

          <div class="contact-method">
            <h3>{String(contact.content?.feedback?.title ?? '')}</h3>
            <p>{String(contact.content?.feedback?.description ?? '')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</AuxiliaryLayout>

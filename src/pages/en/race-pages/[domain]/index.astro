---
import RaceDetailPage from '../../../../components/RaceDetailPage.astro';
import {
  getAllRaceListRows,
} from '../../../../lib/raceListSsg';
import {
  loadIndexYaml,
  raceListSlug,
} from '../../../../lib/content';

export async function getStaticPaths() {
  const paths: Array<{ params: { domain: string } }> = [];
  const seen = new Set<string>();
  const country = 'se';
  const allRows = await getAllRaceListRows(country);
  for (const row of allRows.rows) {
    const key = `${country}:${row.domain_name}`;
    if (seen.has(key)) continue;
    seen.add(key);
    paths.push({
      params: {
        domain: row.domain_name,
      },
    });
  }
  return paths;
}

const country = 'se';
const { domain } = Astro.params;
const content = loadIndexYaml(country, 'en');
const allRows = await getAllRaceListRows(country);
const row = allRows.rows.find((entry) => entry.domain_name === domain);

if (!row) {
  return Astro.redirect(`/en/${raceListSlug(content, country)}/`, 302);
}

const alternateHref = `/${String(loadIndexYaml(country, 'native').race_page_folder_name ?? 'loppsidor')}/${domain}/`;
---

<RaceDetailPage
  country={country}
  locale="en"
  content={content}
  row={row}
  allRows={allRows.rows}
  canonicalPath={`/en/race-pages/${domain}/`}
  alternateHref={alternateHref}
/>

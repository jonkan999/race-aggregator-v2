---
import RaceDetailPage from '../../../../components/RaceDetailPage.astro';
import { getAllRaceListRows } from '../../../../lib/raceListSsg';
import { loadIndexYaml, raceListSlug } from '../../../../lib/content';

export async function getStaticPaths() {
  const allRows = await getAllRaceListRows('no');
  const seen = new Set<string>();

  return allRows.rows.flatMap((row) => {
    if (seen.has(row.domain_name)) return [];
    seen.add(row.domain_name);
    return [{ params: { domain: row.domain_name } }];
  });
}

const { domain } = Astro.params;
const country = 'no';
const content = loadIndexYaml(country, 'native');
const allRows = await getAllRaceListRows(country);
const row = allRows.rows.find((entry) => entry.domain_name === domain);

if (!row) {
  return Astro.redirect(`/${country}/${raceListSlug(content, country)}/`, 302);
}

const alternateHref = `/${country}/en/race-pages/${domain}/`;
---

<RaceDetailPage
  country={country}
  locale="native"
  content={content}
  row={row}
  allRows={allRows.rows}
  canonicalPath={`/${country}/lopssider/${domain}/`}
  alternateHref={alternateHref}
/>

---
import AuxiliaryLayout from '../layouts/AuxiliaryLayout.astro';
import AuxiliaryPageIntro from '../components/AuxiliaryPageIntro.astro';
import { alternateAuxiliaryPageHref } from '../lib/auxiliaryPages';
import { loadIndexYaml, type Locale } from '../lib/content';
import paceData from '../data/tools/paceTable.json';

const country = 'se';
const locale: Locale = 'native';
const content = loadIndexYaml(country, locale);
const pageTitle = String(content.pace_calculator_title ?? content.navigation?.['pace-calculator'] ?? 'Fartomvandlare');
const title = `${pageTitle} | ${content.page_name ?? 'Loppkartan'}`;
const description = String(content.pace_calculator_description ?? '');
const alternateHref = alternateAuxiliaryPageHref({ country, locale, pageKey: 'pace-calculator' });
const rows = Array.isArray((paceData as { pace_conversions?: unknown[] }).pace_conversions)
  ? (paceData as { pace_conversions: Array<Record<string, string | number>> }).pace_conversions
  : [];
---

<AuxiliaryLayout
  title={title}
  description={description}
  lang={content.country_language_code ?? 'sv'}
  country={country}
  locale={locale}
  content={content}
  alternateHref={alternateHref}
  breadcrumbLabel={pageTitle}
  schemaType="WebApplication"
>
  <section class="section-pace-calculator">
    <div class="container">
      <AuxiliaryPageIntro
        title={pageTitle}
        description={description}
        note={String(content.pace_conversion_note ?? '')}
        noteClass="conversion-note"
      />

      <div class="pace-table-container">
        <table class="pace-table">
          <thead>
            <tr>
              <th>{String(content.pace_table_header_kph ?? '')}</th>
              <th>{String(content.pace_table_header_min_km ?? '')}</th>
              <th>{String(content.pace_table_header_min_mile ?? '')}</th>
              <th>{String(content.pace_table_header_5k ?? '')}</th>
              <th>{String(content.pace_table_header_10k ?? '')}</th>
              <th>{String(content.pace_table_header_half ?? '')}</th>
              <th>{String(content.pace_table_header_full ?? '')}</th>
            </tr>
          </thead>
          <tbody id="pace-table-body">
            {rows.map((row) => (
              <tr>
                <td>{typeof row.speed_kph === 'number' ? row.speed_kph.toFixed(1) : row.speed_kph}</td>
                <td>{String(row.per_km ?? '')}</td>
                <td>{String(row.per_mile ?? '')}</td>
                <td>{String(row['5k'] ?? '')}</td>
                <td>{String(row['10k'] ?? '')}</td>
                <td>{String(row.half_marathon ?? '')}</td>
                <td>{String(row.marathon ?? '')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AuxiliaryLayout>

{
  "name": "race-aggregator-v2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/generate-market-routes.mjs && rm -rf node_modules/.vite && astro dev",
    "build": "node scripts/generate-market-routes.mjs && node scripts/build-with-race-list-snapshots.mjs",
    "build:astro": "node scripts/generate-market-routes.mjs && astro build",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "export-markers": "node scripts/export-markers.mjs",
    "export-race-list-snapshots": "node scripts/export-race-list-snapshots.mjs",
    "build-category-seo-cache": "node scripts/build-category-seo-cache.mjs",
    "build-browse-seo-cache": "node scripts/build-browse-seo-cache.mjs",
    "build-auth-email-templates": "node scripts/build-supabase-auth-templates.mjs",
    "validate:content": "node scripts/validate-content-contract.mjs",
    "seed-races": "node scripts/seed-races.mjs",
    "test:e2e": "playwright test",
    "test:e2e:legacy-ref": "PW_LEGACY_REFERENCE=1 PW_SKIP_WEB_SERVER=1 playwright test --project=legacy-reference"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^5.4.2",
    "js-yaml": "^4.1.0",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "supabase": "^2.84.4",
    "typescript": "^5.7.3"
  }
}

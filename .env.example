# Active market selection
MARKET_CODE=se

# Optional: point the app at race-collector-v2/data/countries during local development
# MARKET_DATA_ROOT=/Users/jonkan/repos/race-collector-v2/data/countries

# Browser (Astro public — safe to expose; use Publishable key from Supabase dashboard)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Server-only (seed + export-markers + optional Astro build snapshot — never commit)
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase CLI (local machine or CI only — never commit; not used by Astro runtime)
# Create at https://supabase.com/dashboard/account/tokens — required for `npx supabase login` alternative in CI
# SUPABASE_ACCESS_TOKEN=sbp_...

# Optional: browse SEO generation. If set locally, `npm run build` prefers generated browse SEO
# and caches it under data/countries/{code}/seo_content_cache*.json. Missing or new combinations
# are generated once, then reused from cache on later builds.
# OPENAI_API_KEY=sk-...
# Optional: override auto-selection or choose a specific browse SEO model
# BROWSE_SEO_PROVIDER=openai
# OPENAI_SEO_MODEL=gpt-5-mini

# Optional: project URL alias for scripts if PUBLIC_SUPABASE_URL is unset
# SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy JWT elevated key (deprecated): only if you have not created a Secret key yet.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
